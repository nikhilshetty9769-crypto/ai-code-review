# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your MongoDB Atlas connection string:
# mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai_code_review?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ai_code_review

# Allowed Frontend Origins (CORS)
CLIENT_URL=http://localhost:5173

# Google Gemini API Configuration
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
